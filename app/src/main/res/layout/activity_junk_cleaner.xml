<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/junk_cleaner_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            app:layout_constraintStart_toEndOf="@id/btn_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="8dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- JUNK VIEW CONTAINER (Initially Visible) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/junk_view_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Total Size Circle -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/size_container"
            android:layout_width="200dp"
            android:layout_height="200dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp">

            <!-- Circle Background -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/circle_outline_blue" />

            <!-- Size Text -->
            <TextView
                android:id="@+id/tv_total_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="..."
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_bias="0.45" />

            <!-- Label -->
            <TextView
                android:id="@+id/tv_total_size_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/junk_cleaner_trash_size"
                android:textSize="14sp"
                android:textColor="@color/gray_dark"
                app:layout_constraintTop_toBottomOf="@id/tv_total_size"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="4dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Disclaimer -->
        <TextView
            android:id="@+id/tv_disclaimer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/junk_cleaner_disclaimer"
            android:textSize="14sp"
            android:textColor="@color/gray_dark"
            android:gravity="center"
            android:background="@color/gray_light"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/size_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

        <!-- Categories List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/tv_disclaimer"
            app:layout_constraintBottom_toTopOf="@id/btn_clean_up"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Clean Up Button -->
        <Button
            android:id="@+id/btn_clean_up"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Clean Up"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/button_primary_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="32dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- PROGRESS VIEW CONTAINER (Initially Hidden) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/progress_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Circular Progress Bar -->
        <ProgressBar
            android:id="@+id/circular_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:progress="0"
            android:max="100"
            android:progressDrawable="@drawable/circular_progress_drawable"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.25"
            android:layout_marginTop="32dp" />

        <!-- Progress Percentage -->
        <TextView
            android:id="@+id/tv_progress_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60%"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            app:layout_constraintTop_toTopOf="@id/circular_progress_bar"
            app:layout_constraintBottom_toBottomOf="@id/circular_progress_bar"
            app:layout_constraintStart_toStartOf="@id/circular_progress_bar"
            app:layout_constraintEnd_toEndOf="@id/circular_progress_bar" />

        <!-- Progress Status -->
        <TextView
            android:id="@+id/tv_progress_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cleaning..."
            android:textSize="16sp"
            android:textColor="@color/gray_dark"
            app:layout_constraintTop_toBottomOf="@id/circular_progress_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <!-- Stop Cleaning Button -->
        <Button
            android:id="@+id/btn_stop_cleaning"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Stop Cleaning"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/button_danger_bg"
            android:drawableEnd="@drawable/ic_bolt"
            android:drawablePadding="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_progress_status"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="32dp" />

        <!-- Progress Disclaimer -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/junk_cleaner_disclaimer"
            android:textSize="14sp"
            android:textColor="@color/gray_dark"
            android:gravity="center"
            android:background="@color/gray_light"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/btn_stop_cleaning"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

        <!-- Categories List During Progress (same RecyclerView, will be updated) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/progress_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/btn_stop_cleaning"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="80dp"
            android:layout_marginBottom="16dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
